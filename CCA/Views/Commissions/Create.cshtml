@model CCA.ViewModels.CommissionRequestViewModel
@{
    ViewData["Title"] = $"Request Commission - {Model.ArtistName}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h4 class="fw-bold mb-0">🎨 Request Commission</h4>
                    <small class="text-muted">with @Model.ArtistName</small>
                </div>
                <div class="card-body p-4 p-md-5">
                    <!-- ✅ CRITICAL: asp-action="Submit" matches the POST route -->
                    <form asp-action="Submit" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ArtistId" />
                        
                        <!-- Commission Tier Selection -->
                        <div class="mb-4">
                            <label asp-for="BasePrice" class="form-label fw-bold">Commission Package</label>
                            <select asp-for="BasePrice" class="form-select" id="tierSelect">
                                @if (Model.AvailableTiers != null)
                                {
                                    @foreach (var tier in Model.AvailableTiers)
                                    {
                                        <option value="@tier.Value">@tier.Text</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="BasePrice" class="text-danger small"></span>
                        </div>

                        <!-- Project Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Project Details</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe what you'd like commissioned (subject, size, reference images, deadline, etc.)..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                            <small class="text-muted">Be as detailed as possible for the best results.</small>
                        </div>

                        <!-- Turnaround Time -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Turnaround Preference</label>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <input type="radio" class="btn-check" name="TurnaroundOption" id="standard" value="standard" checked>
                                    <label class="btn btn-outline-primary w-100" for="standard">
                                        📅 Standard (2-3 weeks)
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <input type="radio" class="btn-check" name="TurnaroundOption" id="express" value="express">
                                    <label class="btn btn-outline-warning w-100" for="express">
                                        ⚡ Express (1 week) <small class="text-muted">+25%</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Price Summary -->
                        <div class="mb-4 p-3 bg-light rounded">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Base Price:</span>
                                <span class="fw-bold" id="basePriceDisplay">$@Model.BasePrice.ToString("F0")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Express Fee:</span>
                                <span class="fw-bold text-warning" id="expressFeeDisplay">$0</span>
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold fs-5">Total:</span>
                                <span class="fw-bold text-primary fs-4" id="totalDisplay">$@Model.BasePrice.ToString("F0")</span>
                            </div>
                            <input type="hidden" asp-for="Total" id="totalInput" />
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary px-4 flex-grow-1">
                                💰 Submit Request
                            </button>
                            <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tierSelect = document.getElementById('tierSelect');
            const expressRadio = document.getElementById('express');
            const basePriceDisplay = document.getElementById('basePriceDisplay');
            const expressFeeDisplay = document.getElementById('expressFeeDisplay');
            const totalDisplay = document.getElementById('totalDisplay');
            const totalInput = document.getElementById('totalInput');
            
            function updateTotal() {
                const basePrice = parseFloat(tierSelect?.value) || 0;
                const isExpress = expressRadio?.checked;
                const expressFee = isExpress ? basePrice * 0.25 : 0;
                const total = basePrice + expressFee;
                
                basePriceDisplay.textContent = `$${basePrice.toFixed(0)}`;
                expressFeeDisplay.textContent = isExpress ? `$${expressFee.toFixed(0)}` : '$0';
                totalDisplay.textContent = `$${total.toFixed(0)}`;
                if (totalInput) totalInput.value = total.toFixed(2);
            }
            
            tierSelect?.addEventListener('change', updateTotal);
            expressRadio?.addEventListener('change', updateTotal);
            updateTotal(); // Initial calculation
        });
    </script>
}