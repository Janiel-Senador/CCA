@{
    ViewData["Title"] = "Request Received";
}

<partial name="_TopAppBar" />

<main class="container py-5 text-center">
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-body py-5">
            <h2 class="display-4 text-teal mb-3">✓</h2>
            <h3 class="fw-bold mb-3">Request Submitted!</h3>
            <p class="text-muted mb-4">Your commission request has been sent to the artist. You'll receive a confirmation email shortly.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Browse More</a>
                <a asp-controller="Artists" asp-action="Profile" asp-route-slug="demo" class="btn btn-teal">View Artist</a>
            </div>
        </div>
    </div>
</main>

<partial name="_Footer" />