@model List<CCA.Models.Artist>
@{
    ViewData["Title"] = "Pending Artist Verifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Pending Artist Verifications</h3>
        <span class="badge bg-primary">@Model.Count pending</span>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Artist</th>
                                <th>Email</th>
                                <th>Portfolio</th>
                                <th>Commission Tiers</th>
                                <th>Joined</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var artist in Model)
                            {
                                var user = artist.ApplicationUser;
                                if (user == null) continue;

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@(user.PortraitUrl?.StartsWith("/") == true ? user.PortraitUrl : "/" + (user.PortraitUrl ?? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(artist.Name) + "&background=random"))"
                                                 class="rounded-circle border me-2" width="40" height="40" alt="@artist.Name">
                                            <div>
                                                <strong>@artist.Name</strong>
                                                @if (!string.IsNullOrEmpty(artist.Location))
                                                {
                                                    <br><small class="text-muted">📍 @artist.Location</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="mailto:@user.Email">@user.Email</a>
                                        @if (user.EmailConfirmed)
                                        {
                                            <br><span class="badge bg-success">Confirmed</span>
                                        }
                                    </td>
                                    <td>
                                        @if (artist.Artworks?.Any() == true)
                                        {
                                            <span class="badge bg-info text-dark">@artist.Artworks.Count artworks</span>
                                        }
                                        else
                                        {
                                            <small class="text-muted">No artworks</small>
                                        }
                                    </td>
                                    <td>
                                        @if (artist.CommissionTiers?.Any() == true)
                                        {
                                            <span class="badge bg-info text-dark">@artist.CommissionTiers.Count tiers</span>
                                        }
                                        else
                                        {
                                            <small class="text-muted">No tiers</small>
                                        }
                                    </td>
                                    <td>@artist.MemberSince.ToString("MMM d, yyyy")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <!-- Approve Form -->
                                            <form asp-controller="Admin" asp-action="VerifyArtist" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="approve" value="true" />
                                                <button type="submit" class="btn btn-success" onclick="return confirm('Approve @artist.Name as a verified artist?')">✓ Approve</button>
                                            </form>
                                            
                                            <!-- Decline Button with Modal -->
                                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#declineModal_@user.Id">✗ Decline</button>
                                        </div>
                                        
                                        <!-- Decline Modal -->
                                        <div class="modal fade" id="declineModal_@user.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <form asp-controller="Admin" asp-action="VerifyArtist" method="post" class="modal-content">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <input type="hidden" name="approve" value="false" />
                                                    <div class="modal-header">
                                                        <h6 class="modal-title">Decline Verification</h6>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <label class="form-label">Reason (Optional)</label>
                                                        <textarea name="reason" class="form-control" rows="3" placeholder="Explain why verification was declined..."></textarea>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger">Decline</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <div class="display-1 mb-3 text-success">✓</div>
                <h5 class="fw-bold mb-2">All artists are verified!</h5>
                <p class="text-muted mb-0">No pending verification requests at this time.</p>
            </div>
        </div>
    }
</div> 