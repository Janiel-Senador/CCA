@model CCA.ViewModels.ArtistProfileViewModel
@inject Microsoft.AspNetCore.Identity.SignInManager<CCA.Models.ApplicationUser> SignInManager
@{
    ViewData["Title"] = $"{Model?.Name ?? "Artist"} - Profile";
}

<div class="container py-4">
    <!-- Profile Header -->
    <div class="row mb-4">
        <div class="col-md-3 text-center">
            <img src="@(Model?.PortraitUrl?.StartsWith("/") == true ? Model.PortraitUrl : "/" + (Model?.PortraitUrl ?? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model?.Name ?? "Artist") + "&background=random"))"
                 class="rounded-circle border shadow-sm mb-3" width="150" height="150" alt="@Model?.Name"
                 onerror="this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(Model?.Name ?? "Artist"))&background=random'">
            @if (Model?.IsVerified == true)
            {
                <span class="badge bg-success mb-2">Verified Artist</span>
            }
        </div>
        <div class="col-md-9">
            <h2 class="fw-bold mb-1">@Model?.Name</h2>
            <p class="text-muted mb-2">@(Model?.Location ?? "Location not set")</p>
            <div class="d-flex gap-3 mb-3 flex-wrap">
                <span>⭐ @(Model?.Rating.ToString("F1") ?? "0.0")</span>
                <span>@(Model?.ArtStyles ?? "No styles listed")</span>
                <span>@(Model?.ResponseTime ?? "Unknown")</span>
            </div>
            @* ✅ FIXED: Uses Model?.ApplicationUser?.Email safely *@
            @if (SignInManager.IsSignedIn(User) && User.Identity?.Name != Model?.ApplicationUser?.Email)
            {
                <a asp-controller="Commissions" asp-action="Create" asp-route-artistId="@(Model?.Id)" class="btn btn-primary px-4">Request Commission</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model?.Bio))
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">About @Model?.Name</h5>
                <p>@Model.Bio</p>
            </div>
        </div>
    }

    @if (Model?.Rates != null && Model.Rates.Any())
    {
        <div class="mb-4">
            <h5 class="fw-bold mb-3">Commission Rates</h5>
            <div class="row g-3">
                @foreach (var tier in Model.Rates)
                {
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="fw-bold text-primary mb-1">@tier.Name</h6>
                                <p class="small text-muted mb-2">@(tier.Description ?? "")</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">$@tier.Price.ToString("F0")</span>
                                    <a asp-controller="Commissions" asp-action="Create" asp-route-artistId="@(Model.Id)" class="btn btn-sm btn-outline-primary">Request</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model?.Portfolio != null && Model.Portfolio.Any())
    {
        <div class="mb-4">
            <h5 class="fw-bold mb-3">Portfolio</h5>
            <div class="row g-3">
                @foreach (var art in Model.Portfolio)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card border-0 shadow-sm h-100">
                            <img src="@(art.ImageUrl?.StartsWith("/") == true ? art.ImageUrl : "/" + (art.ImageUrl ?? "https://via.placeholder.com/300x220"))"
                                 class="card-img-top" style="height:180px;object-fit:cover;" alt="@(art.Title ?? "Artwork")">
                            <div class="card-body p-2">
                                <h6 class="small fw-bold mb-0">@(art.Title ?? "Untitled")</h6>
                                <small class="text-muted">@(art.Category ?? "Uncategorized")</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>