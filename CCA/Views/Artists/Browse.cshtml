@{
    ViewData["Title"] = "Browse Artists";
}

<main class="container py-4">
    <div class="row g-4">
        @* Sidebar Filters *@
        <aside class="col-lg-3">
            <div class="sticky-top pt-4">
                <h5 class="fw-bold mb-3">Filters</h5>
                
                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase">Art Style</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-sm btn-teal">Impressionist</button>
                        <button class="btn btn-sm btn-outline-secondary">Abstract</button>
                        <button class="btn btn-sm btn-outline-secondary">Realism</button>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase">Price Range</label>
                    <input type="range" class="form-range" min="100" max="10000" step="100">
                    <div class="d-flex justify-content-between small text-muted">
                        <span>$100</span><span>$10,000+</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase">Delivery</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="under1w" checked>
                        <label class="form-check-label small" for="under1w">Under 1 Week</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="1to4w" checked>
                        <label class="form-check-label small" for="1to4w">1-4 Weeks</label>
                    </div>
                </div>
            </div>
        </aside>

        @* Main Content *@
        <section class="col-lg-9">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <span class="text-uppercase text-muted small fw-bold">Curated Collections</span>
                    <h2 class="fw-bold">Discover Masters</h2>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown">
                        Sort: Featured
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Price: Low to High</a></li>
                        <li><a class="dropdown-item" href="#">Price: High to Low</a></li>
                        <li><a class="dropdown-item" href="#">Rating</a></li>
                    </ul>
                </div>
            </div>

            @* Featured Large Card *@
            <div class="card border-0 shadow-sm mb-4">
                <div class="row g-0">
                    <div class="col-md-5">
                        <div class="bg-dark rounded-start" style="height: 300px;"></div>
                    </div>
                    <div class="col-md-7">
                        <div class="card-body d-flex flex-column justify-content-between h-100">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="text-warning">★</span><span class="fw-bold">4.9</span>
                                    <small class="text-muted">(142 reviews)</small>
                                </div>
                                <h4 class="fw-bold">Elena Rostova</h4>
                                <p class="text-muted small">Specializes in emotive impressionist portraits and lush floral compositions.</p>
                                <div class="small">
                                    <span class="text-muted">Starting from</span> <span class="fw-bold text-teal ms-2">$1,200</span>
                                    <span class="text-muted ms-3">Timeline:</span> <span class="fw-bold ms-1">3 Weeks</span>
                                </div>
                            </div>
                            <a asp-controller="Artists" asp-action="Profile" asp-route-slug="elena" class="btn btn-teal mt-3">View Portfolio</a>
                        </div>
                    </div>
                </div>
            </div>

            @* Artist Grid *@
            <div class="row g-4">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="col-md-6">
                        <partial name="_ArtistCard" />
                    </div>
                }
            </div>

            @* Pagination *@
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled"><a class="page-link" href="#">Prev</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">...</a></li>
                    <li class="page-item"><a class="page-link" href="#">12</a></li>
                    <li class="page-item"><a class="page-link" href="#">Next</a></li>
                </ul>
            </nav>
        </section>
    </div>
</main>

