@model IEnumerable<CCA.Models.Artist>
@{
    ViewData["Title"] = "Browse Artists";
}

<div class="container py-4">
    <!-- Header & Search -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-0">🎨 Browse Artists</h2>
            <p class="text-muted mb-0">Discover talented artists for your next commission</p>
        </div>
        
        <form asp-action="Browse" method="get" class="d-flex" style="max-width: 350px; width: 100%;">
            <input type="search"
                   name="search"
                   class="form-control form-control-sm me-2"
                   placeholder="Search artists, styles, locations..."
                   value="@Context.Request.Query["search"]"
                   aria-label="Search artists">
            <button type="submit" class="btn btn-outline-secondary btn-sm">🔍</button>
            @if (!string.IsNullOrEmpty(Context.Request.Query["search"]))
            {
                <a asp-action="Browse" class="btn btn-outline-secondary btn-sm ms-1">✕</a>
            }
        </form>
    </div>

    <!-- Results Count -->
    @if (Model != null)
    {
        <p class="text-muted small mb-3">
            @Model.Count() artist@(Model.Count() != 1 ? "s" : "") found
            @if (!string.IsNullOrEmpty(Context.Request.Query["search"]))
            {
                <span>for "<strong>@Context.Request.Query["search"]</strong>"</span>
            }
        </p>
    }

    <!-- Artist Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var artist in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100 hover-shadow transition">
                        <!-- Artist Image with Verified Badge -->
                        <div class="position-relative">
                            @* ✅ FIX: Null-safe profile picture path with fallback *@
                            <img src="@(artist?.ApplicationUser?.PortraitUrl?.StartsWith("/") == true
                                                                                               ? artist.ApplicationUser.PortraitUrl
                                                                                               : "/" + (artist?.ApplicationUser?.PortraitUrl ?? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(artist?.Name ?? "Artist") + "&background=random"))"
                                 class="card-img-top"
                                 style="height: 220px; object-fit: cover; width: 100%;"
                                 alt="@artist?.Name"
                                 onerror="this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(artist?.Name ?? "Artist"))&background=random'">
                            
                            @if (artist?.ApplicationUser?.IsVerified == true)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-2 shadow-sm">
                                    ✓ Verified
                                </span>
                            }
                            
                            <!-- Quick Commission Price Badge -->
                            @if (artist?.CommissionTiers?.Any() == true)
                            {
                                <span class="badge bg-primary position-absolute bottom-0 start-0 m-2">
                                    From $@artist.CommissionTiers.Min(t => t.Price).ToString("F0")
                                </span>
                            }
                        </div>
                        
                        <!-- Artist Info -->
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">@artist?.Name</h5>
                                <span class="text-muted small">⭐ @artist?.Rating.ToString("F1")</span>
                            </div>
                            
                            <!-- Location -->
                            @if (!string.IsNullOrEmpty(artist?.Location))
                            {
                                <p class="card-text text-muted small mb-2">
                                    <i class="bi bi-geo-alt"></i> @artist.Location
                                </p>
                            }
                            
                            <!-- Art Styles -->
                            @if (!string.IsNullOrEmpty(artist?.ArtStyles))
                            {
                                <div class="mb-3">
                                    @foreach (var style in (artist.ArtStyles?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>()).Take(3))
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1" style="font-size: 0.7rem;">
                                            @style.Trim()
                                        </span>
                                    }
                                    @if ((artist.ArtStyles?.Split(',', StringSplitOptions.RemoveEmptyEntries)?.Length ?? 0) > 3)
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1" style="font-size: 0.7rem;">+ more</span>
                                    }
                                </div>
                            }
                            
                            <!-- Bio Preview -->
                            @if (!string.IsNullOrEmpty(artist?.Bio))
                            {
                                <p class="card-text small text-muted mb-3">
                                    @(artist.Bio.Length > 100 ? artist.Bio.Substring(0, 100) + "..." : artist.Bio)
                                </p>
                            }
                            
                            <!-- Stats Row -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    <small class="text-muted">
                                        🎨 @(artist?.Artworks?.Count ?? 0) artworks
                                    </small>
                                </div>
                                <a asp-action="Profile" asp-route-slug="@artist?.Slug" class="btn btn-sm btn-outline-primary">
                                    View Profile →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="display-1 mb-3 text-muted">🎨</div>
                <h4 class="fw-bold mb-2">No artists found</h4>
                <p class="text-muted mb-4">
                    @if (!string.IsNullOrEmpty(Context.Request.Query["search"]))
                    {
                        <span>Try adjusting your search for "<strong>@Context.Request.Query["search"]</strong>"</span>
                    }
                    else
                    {
                        <span>Check back later for new talent, or become an artist yourself!</span>
                    }
                </p>
                <div class="d-flex justify-content-center gap-2">
                    @if (!string.IsNullOrEmpty(Context.Request.Query["search"]))
                    {
                        <a asp-action="Browse" class="btn btn-outline-secondary">Clear Search</a>
                    }
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
                        Become an Artist
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Pagination (Optional - Add when you have many artists) -->
    @*
    <nav class="mt-4" aria-label="Artist pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">Next</a></li>
        </ul>
    </nav>
    *@
</div>

<!-- Custom Styles for Hover Effects -->
<style>
    .hover-shadow {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-shadow:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .transition {
        transition: all 0.2s ease;
    }
</style>

@section Scripts {
    <script>
        // Optional: Add lazy loading for images if you have many artists
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('img.card-img-top');
            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            img.src = img.dataset.src || img.src;
                            observer.unobserve(img);
                        }
                    });
                });
                images.forEach(img => observer.observe(img));
            }
        });
    </script>
}