@model CCA.ViewModels.CategoryStyleViewModel
@{
    ViewData["Title"] = $"{Model.StyleName} Artists";
}

<style>
    .artwork-slider {
        display: flex;
        overflow-x: auto;
        gap: 1rem;
        padding: 0.5rem 0 1rem 0;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
    }
    .artwork-slider::-webkit-scrollbar { height: 6px; }
    .artwork-slider::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    .artwork-slide {
        flex: 0 0 220px;
        scroll-snap-align: start;
    }
    .artwork-slide img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-radius: 8px;
        transition: transform 0.2s;
    }
    .artwork-slide img:hover { transform: scale(1.03); }
</style>

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Model.StyleName</h2>
            <p class="text-muted mb-0">@Model.Artists.Count artists • @Model.Artists.Sum(a => a.StyleArtworks.Count) artworks</p>
        </div>
        <a asp-controller="Artists" asp-action="Browse" class="btn btn-outline-secondary">Browse All Artists</a>
    </div>

    @if (Model.Artists.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model.Artists)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-4">
                            <!-- Artist Info -->
                            <div class="d-flex align-items-center mb-3">
                                <img src="@(item.Artist.ApplicationUser?.PortraitUrl?.StartsWith("/") == true 
                                      ? item.Artist.ApplicationUser.PortraitUrl 
                                      : "/" + (item.Artist.ApplicationUser?.PortraitUrl ?? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(item.Artist.Name) + "&background=random"))"
                                     class="rounded-circle border me-3" width="60" height="60" alt="@item.Artist.Name">
                                <div>
                                    <h5 class="fw-bold mb-0">
                                        <a asp-controller="Artists" asp-action="Profile" asp-route-slug="@item.Artist.Slug" class="text-decoration-none text-dark">
                                            @item.Artist.Name
                                        </a>
                                    </h5>
                                    <small class="text-muted">@item.Artist.Location • @item.StyleArtworks.Count artworks in @Model.StyleName</small>
                                </div>
                            </div>

                            <!-- Live Artwork Slider -->
                            <div class="artwork-slider">
                                @foreach (var art in item.StyleArtworks)
                                {
                                    <div class="artwork-slide">
                                        <a asp-controller="Artists" asp-action="Profile" asp-route-slug="@art.Artist?.Slug">
                                            <img src="@(art.ImageUrl?.StartsWith("/") == true ? art.ImageUrl : "/" + art.ImageUrl)" 
                                                 alt="@art.Title" 
                                                 onerror="this.src='https://via.placeholder.com/220x160?text=No+Image'">
                                        </a>
                                        <div class="mt-2 text-center">
                                            <small class="fw-bold d-block text-truncate" style="max-width:200px;">@art.Title</small>
                                            <a asp-controller="Commissions" asp-action="Create" asp-route-artistId="@art.Artist?.Id" class="btn btn-sm btn-outline-primary w-100 mt-1">
                                                Request Commission
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <p class="text-muted mb-0">No artists have uploaded artworks in <strong>@Model.StyleName</strong> yet.</p>
                <a asp-controller="Artists" asp-action="Browse" class="btn btn-outline-primary mt-3">Browse Other Styles</a>
            </div>
        </div>
    }
</div>