@model CCA.ViewModels.ArtworksByCategoryViewModel
@{
    ViewData["Title"] = $"{Model.Category} Artworks";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Model.Category</h2>
            <p class="text-muted mb-0">@Model.ArtistCount artists • @Model.Artworks.Count artworks</p>
        </div>
        <a asp-controller="Artists" asp-action="Browse" asp-route-search="@Model.Category" class="btn btn-outline-secondary">
            View Artists →
        </a>
    </div>

    <!-- Artwork Grid -->
    @if (Model.Artworks.Any())
    {
        <div class="row g-4">
            @foreach (var art in Model.Artworks)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card border-0 shadow-sm h-100">
                        <!-- ✅ Clickable image that links to artist profile -->
                        <a asp-controller="Artists" asp-action="Profile" asp-route-slug="@art.Artist?.Slug">
                            <img src="@(art.ImageUrl?.StartsWith("/") == true ? art.ImageUrl : "/" + (art.ImageUrl ?? "https://via.placeholder.com/300x220"))"
                                 class="card-img-top" style="height: 200px; object-fit: cover;"
                                 alt="@art.Title"
                                 onerror="this.src='https://via.placeholder.com/300x220?text=Image+Not+Found'">
                        </a>
                        <div class="card-body">
                            <h6 class="fw-bold mb-1">
                                <a asp-controller="Artists" asp-action="Profile" asp-route-slug="@art.Artist?.Slug" class="text-decoration-none text-dark">
                                    @art.Title
                                </a>
                            </h6>
                            <p class="card-text text-muted small mb-2">by @art.Artist?.Name</p>
                            @if (!string.IsNullOrEmpty(art.Medium))
                            {
                                <small class="text-muted d-block">@art.Medium</small>
                            }
                            @if (art.Artist?.ApplicationUser?.IsVerified == true)
                            {
                                <span class="badge bg-success mt-2">Verified Artist</span>
                            }
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <a asp-controller="Commissions" asp-action="Create" asp-route-artistId="@art.Artist?.Id" class="btn btn-sm btn-primary w-100">
                                Request Commission
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <p class="text-muted mb-0">No artworks found in this category yet.</p>
                <a asp-controller="Artists" asp-action="Browse" class="btn btn-outline-primary mt-3">Browse All Artists</a>
            </div>
        </div>
    }
</div>