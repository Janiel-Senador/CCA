@{
    ViewData["Title"] = "Browse";
}

<!-- Hero Section -->
<div class="row align-items-center mb-5">
    <div class="col-md-6">
        <span class="text-uppercase text-muted small fw-bold">Artist Spotlight</span>
        <h1 class="display-3 mt-2">Mastering the Quietude</h1>
        <p class="lead text-muted">Discover the evocative landscapes of Elena Thorne, whose latest commission series explores the intersection of brutalist architecture and ethereal light.</p>
        <button class="btn btn-primary-cca mt-3">Commission Artist</button>
        <a href="#" class="ms-3 text-decoration-none text-dark fw-bold">Explore Portfolio &rarr;</a>
    </div>
    <div class="col-md-6">
        <!-- Placeholder for Hero Image -->
        <div class="bg-light rounded p-5 text-center" style="height: 300px; background: linear-gradient(45deg, #e0f2f1, #fff);">
            <span class="text-muted">Hero Artwork Image</span>
        </div>
    </div>
</div>

<!-- Trending Categories -->
<h3 class="mb-4">Trending Categories</h3>
<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="position-relative rounded overflow-hidden" style="height: 300px; background-color: #1a1a1a;">
            <div class="position-absolute bottom-0 start-0 p-3 text-white">
                <h4>Digital Illustration</h4>
                <small>2,400+ Artists active</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="position-relative rounded overflow-hidden" style="height: 140px; background-color: #5d4037;">
            <div class="position-absolute bottom-0 start-0 p-3 text-white"><h5>Oil Portraits</h5></div>
        </div>
        <div class="position-relative rounded overflow-hidden mt-3" style="height: 140px; background-color: #37474f;">
            <div class="position-absolute bottom-0 start-0 p-3 text-white"><h5>Character Design</h5></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="position-relative rounded overflow-hidden" style="height: 300px; background-color: #263238;">
            <div class="position-absolute bottom-0 start-0 p-3 text-white"><h5>Sculpture</h5></div>
        </div>
    </div>
</div>

<!-- Recent Commissions -->
<h3 class="mb-4">Recent Commissions</h3>
<div class="row">
    <!-- Commission Item -->
    <div class="col-md-4 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="bg-dark" style="height: 250px;"></div>
            <div class="card-body">
                <h5 class="card-title">The Celestial Shore</h5>
                <p class="text-muted small">by Julian Vossen</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">$450</span>
                    <span class="badge bg-light text-dark border">4.9 ★</span>
                </div>
            </div>
        </div>
    </div>
    <!-- Repeat for other items... -->
</div>