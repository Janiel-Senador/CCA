@model CCA.ViewModels.ArtistSettingsViewModel
@{
    ViewData["Title"] = "Artist Settings & Styles";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h4 class="fw-bold mb-0">🎨 Artist Settings & Styles</h4>
            </div>
            <div class="card-body p-4 p-md-5">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                
                <form asp-action="EditSettings" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Art Styles</label>
                        <div class="row g-2">
                            @if (Model?.AllStyles != null)
                            {
                                @foreach (var style in Model.AllStyles)
                                {
                                    <div class="col-md-4 col-sm-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="SelectedStyles" value="@style"
                                                   id="style_@style.Replace(" ", "_")" checked="@(Model.SelectedStyles?.Contains(style) == true)">
                                            <label class="form-check-label" for="style_@style.Replace(" ", "_")">@style</label>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <small class="text-muted">Select all that apply. These will appear on your public profile.</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Bio" class="form-label fw-bold">Artist Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell collectors about your process..."></textarea>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-bold">Studio Location</label>
                            <input asp-for="Location" class="form-control" placeholder="City, Country" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Typical Response Time</label>
                            <select asp-for="ResponseTime" class="form-select">
                                <option value="Under 24h">Under 24h</option>
                                <option value="Under 48h">Under 48h</option>
                                <option value="1-3 Days">1-3 Days</option>
                                <option value="Weekly">Weekly</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary px-4">💾 Save Settings</button>
                </form>
            </div>
        </div>
    </div>
</div>