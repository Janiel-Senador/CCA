@model List<CCA.Models.CommissionRequest>
@{
    ViewData["Title"] = "Commission Requests";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Commission Requests</h3>
        <span class="badge bg-primary">@Model.Count(cr => cr.Status == "Pending") pending</span>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Customer</th>
                                <th>Description</th>
                                <th>Price</th>
                                <th>Turnaround</th>
                                <th>Requested</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.OrderByDescending(r => r.CreatedAt))
                            {
                                <tr class="@(req.Status == "Pending" ? "table-warning" : "")">
                                    <td>
                                        <strong>@req.Customer?.FullName</strong>
                                        <br><small class="text-muted">@req.Customer?.Email</small>
                                    </td>
                                    <td style="max-width: 300px;">
                                        <p class="mb-0 text-truncate" title="@req.Description">@req.Description</p>
                                    </td>
                                    <td class="fw-bold">$@req.TotalPrice.ToString("F0")</td>
                                    <td>
                                        <span class="badge bg-@(req.TurnaroundOption == "express" ? "warning" : "secondary")">
                                            @req.TurnaroundOption
                                        </span>
                                    </td>
                                    <td>@req.CreatedAt.ToString("MMM d, yyyy")</td>
                                    <td>
                                        <span class="badge bg-@(
                                                                                          req.Status == "Accepted" ? "success" :
                                                                                          req.Status == "Declined" ? "danger" :
                                                                                          req.Status == "Completed" ? "primary" :
                                                                                          req.Status == "Cancelled" ? "secondary" : "warning")">
                                            @req.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (req.Status == "Pending")
                                        {
                                            <div class="btn-group btn-group-sm" role="group">
                                                <form asp-controller="ArtistDashboard" asp-action="AcceptCommission" asp-route-id="@req.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success">Accept</button>
                                                </form>
                                                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#declineModal_@req.Id">Decline</button>
                                            </div>
                                            
                                            <div class="modal fade" id="declineModal_@req.Id" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <form asp-controller="ArtistDashboard" asp-action="DeclineCommission" asp-route-id="@req.Id" method="post" class="modal-content">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-header">
                                                            <h6 class="modal-title">Decline Commission</h6>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <label class="form-label">Reason (Optional)</label>
                                                            <textarea name="reason" class="form-control" rows="3" placeholder="Explain why you cannot accept this commission..."></textarea>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger">Decline</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        else if (req.Status == "Accepted")
                                        {
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-controller="Messages" asp-action="Chat" asp-route-userId="@req.CustomerId" class="btn btn-sm btn-primary">Message</a>
                                                <form asp-controller="ArtistDashboard" asp-action="MarkAsCompleted" asp-route-id="@req.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success" onclick="return confirm('Mark this commission as completed?')">Complete</button>
                                                </form>
                                            </div>
                                        }
                                        else if (req.Status == "Completed")
                                        {
                                            <span class="badge bg-success">Completed</span>
                                            <a asp-controller="Messages" asp-action="Chat" asp-route-userId="@req.CustomerId" class="btn btn-sm btn-outline-primary mt-1">Message</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@req.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <p class="mb-3 text-muted">No commission requests at this time.</p>
                <p class="small text-muted mb-4">When customers request your work, they will appear here for you to review.</p>
                <a asp-controller="Artists" asp-action="Profile" asp-route-slug="@Context.User.Identity?.Name?.ToLower().Replace(" ", "-")" class="btn btn-outline-primary">
                    View My Public Profile
                </a>
            </div>
        </div>
    }
</div>