@model List<CCA.ViewModels.NotificationViewModel>
@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Notifications</h3>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">Mark all as read</button>
            </form>
        }
    </div>

    @if (Model.Any())
    {
        <div class="list-group shadow-sm border-0">
            @foreach (var notification in Model)
            {
                <a href="@notification.ActionUrl" class="list-group-item list-group-item-action @(notification.IsRead ? "" : "border-start border-4 border-primary")">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1 fw-bold">@notification.Title</h6>
                        <small class="text-muted">@notification.Timestamp.ToString("MMM d, h:mm tt")</small>
                    </div>
                    <p class="mb-1 text-muted">@notification.Message</p>
                    @if (!notification.IsRead)
                    {
                        <span class="badge bg-primary">New</span>
                    }
                </a>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <p class="text-muted mb-0">No notifications at this time.</p>
            </div>
        </div>
    }
</div>